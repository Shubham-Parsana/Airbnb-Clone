<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Edit your Listings</h3> <br>
            <form action="/listings/<%= listing._id %>?_method=PUT" method="post" novalidate class="needs-validation">
                <div>
                    <label for="" class="form-label">Title :</label>
                    <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control" required><br>
                    <div class="valid-feedback">Title looks good</div>
                    <div class="invalid-feedback">Title should be valid</div>
                </div>
        
                <div>
                    <label for="" class="form-label">Description:</label>
                    <textarea name="listing[description]" id="" cols="30" rows="10"value="<%= listing.description %>" class="form-control" required></textarea><br>
                    <div class="valid-feedback">Description looks good</div>
                    <div class="invalid-feedback">Description should be valid</div>
                </div>
        
                <div>
                    <label for="" class="form-label">Image :</label>
                    <input type="text" name="listing[image][filename]" value="<%= listing.image.filename %>" class="form-control"><br>
                </div>
        
                <div class="row">
                    <div class="col-md-4">
                        <label for="" class="form-label">Price:</label>
                        <input type="number" name="listing[price]" id=""value="<%= listing.price %>" class="form-control" required><br>
                        <div class="valid-feedback">Price looks good</div>
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>
            
                    <div class="col-md-8">
                        <label for="" class="form-label">Country</label>
                        <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control" required><br>
                        <div class="valid-feedback">Country looks good</div>
                        <div class="invalid-feedback">Country should be valid</div>
                    </div>
                </div>
                
                <div>
                    <label for="" class="form-label">Location</label>
                    <input type="text" name="listing[location]" value="<%= listing.location %>" class="form-control" required><br>
                    <div class="valid-feedback">Location looks good</div>
                    <div class="invalid-feedback">Location should be valid</div>
                </div>
        
                <button class="btn btn-dark" id="btn1">Edit</button>
            </form>
        </div>
    </div><br>

</body>
